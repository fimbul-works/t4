{
  "name": "@fimbul-works/t4",
  "description": "An ultra-lightweight hierarchical triangular global grid system (DGGS) mapped to the WGS84 ellipsoid. Fast bitwise spatial indexing with sub-decimeter accuracy at up to 29 zoom levels.",
  "version": "1.1.0",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "FimbulWorks <contact@fimbul.works>",
  "homepage": "https://github.com/fimbul-works/t4#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fimbul-works/t4.git"
  },
  "bugs": {
    "url": "https://github.com/fimbul-works/t4/issues"
  },
  "keywords": [
    "dggs",
    "geospatial",
    "spatial-index",
    "spatial-indexing",
    "discrete-global-grid",
    "gis",
    "tetrahedron",
    "triangulation",
    "geohash",
    "h3",
    "s2",
    "wgs84",
    "geodesy",
    "spherical-geometry",
    "quadtree",
    "procedural-generation",
    "planet-generation",
    "marching-tetrahedra",
    "mesh",
    "godot"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "T4.png"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "clean:bundles": "rm -rf bundles",
    "build": "pnpm clean && pnpm build:esm && pnpm build:cjs && pnpm build:docs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:bundles": "pnpm clean:bundles && NODE_OPTIONS='--max-old-space-size=4096' tsdown",
    "build:all": "pnpm build && pnpm build:bundles && pnpm sizes",
    "build:docs": "typedoc",
    "format": "npx biome format --write",
    "test": "vitest",
    "sizes": "npx bundle-size",
    "benchmark": "tsx benchmark_t4.ts",
    "benchmark:h3": "brotli -df t4_corpus.json.br && tsx benchmark_vs_h3.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fimbul-works/vec": "^2.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@fimbul-works/bundle-size": "^1.0.0",
    "@types/node": "^25.9.0",
    "h3-js": "^4.5.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.6"
  }
}
