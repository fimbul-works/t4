{
  "files": {
    "includes": ["**", "!*_t4.json", "!t4_corpus.json", "!benchmarks/**"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noAssignInExpressions": "off"
      },
      "style": {
        "useSingleVarDeclarator": "off"
      }
    }
  }
}
